{
  "$defs": {
    "ExtractInput": {
      "additionalProperties": false,
      "properties": {
        "pages": {
          "items": {
            "$ref": "#/$defs/PageInput"
          },
          "title": "Pages",
          "type": "array"
        },
        "existing_test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Existing Test Id"
        },
        "supersedes_attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Supersedes Attempt Id"
        },
        "series_from_test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series From Test Id"
        },
        "series_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Series Name"
        },
        "again_test_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Again Test Id"
        },
        "again_mode": {
          "anyOf": [
            {
              "enum": [
                "replace",
                "copy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Again Mode"
        },
        "taken_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taken On"
        }
      },
      "required": [
        "pages",
        "existing_test_id",
        "supersedes_attempt_id"
      ],
      "title": "ExtractInput",
      "type": "object"
    },
    "GradeInput": {
      "additionalProperties": false,
      "properties": {
        "test_id": {
          "title": "Test Id",
          "type": "string"
        },
        "attempt_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attempt Id"
        },
        "reason": {
          "enum": [
            "button",
            "key_verified",
            "merge",
            "review_fix",
            "points_fix",
            "after_extract"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "attempt_id",
        "reason"
      ],
      "title": "GradeInput",
      "type": "object"
    },
    "PageInput": {
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "title": "File Id",
          "type": "string"
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ],
          "title": "Rotation",
          "type": "integer"
        },
        "is_key": {
          "title": "Is Key",
          "type": "boolean"
        },
        "text_file_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Text File Id"
        }
      },
      "required": [
        "file_id",
        "rotation",
        "is_key",
        "text_file_id"
      ],
      "title": "PageInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "extract",
        "grade"
      ],
      "title": "Kind",
      "type": "string"
    },
    "input": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtractInput"
        },
        {
          "$ref": "#/$defs/GradeInput"
        }
      ],
      "title": "Input"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "stopping",
        "stopped",
        "interrupted",
        "failed",
        "discarded",
        "done"
      ],
      "title": "Status",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Error"
    }
  },
  "required": [
    "id",
    "thread_id",
    "kind",
    "input",
    "status",
    "started_at",
    "finished_at",
    "error"
  ],
  "title": "Run",
  "type": "object"
}
