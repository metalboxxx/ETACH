{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "npm run build && npm run freeze:sidecar"
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../sidecar/dist/etach-sidecar/": "sidecar/"
    },
    "windows": {
      "nsis": {
        "template": "nsis/installer.nsi",
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
