{
  "name": "etach-app",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "dependencies": {
    "@fontsource/faustina": "5.3.0",
    "@fontsource/federo": "5.3.0",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-dialog": "2.8.1",
    "@tauri-apps/plugin-notification": "2.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "29.1.1",
    "json-schema-to-typescript": "16.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "webdriverio": "9.32.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:types": "node scripts/gen-types.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "e2e": "playwright test",
    "tauri": "node src-tauri/tauri-cli.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "e2e:shell": "node e2e-shell/run.mjs",
    "freeze:sidecar": "cd ../sidecar && uv run pyinstaller etach.spec --noconfirm --clean --distpath dist --workpath build"
  },
  "engines": {
    "node": ">=20"
  }
}
